# --- Frontend ---
# Interactive demo (localStorage mocks). Set to "false" for live sandbox + Supabase.
VITE_USE_MOCKS=true

# Optional absolute API origin. Leave empty to use same-origin /api/* (TanStack/Nitro).
# VITE_API_BASE_URL=https://your-api.example.com

# Public Supabase (anon key is safe for the browser with demo-open RLS).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shown on the Judge mode banner (sandbox buyer email only — never put the password in VITE_*).
VITE_PAYPAL_SANDBOX_BUYER_EMAIL=sb-XXXX@personal.example.com

# Optional public site origin used when minting quote / MCP links.
# VITE_PUBLIC_ORIGIN=https://serviceready-frontend.lovable.app

# --- Server only (never VITE_*) ---
# PayPal REST sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Supabase (server). Can mirror the VITE_ values for the demo.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional override for absolute links in emails / quotes
# PUBLIC_ORIGIN=https://serviceready-frontend.lovable.app

# OpenAI-compatible LLM (server only — never VITE_*).
# When unset, catalog/agent/collections fall back to heuristics (tests stay green).
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# xAI / Grok also works: set XAI_API_KEY (uses https://api.x.ai/v1 by default)
# XAI_API_KEY=
